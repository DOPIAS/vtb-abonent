# Copy to .env. Example values below are placeholders, not production secrets.
# Use only URL-safe characters for this password (for example: openssl rand -hex 24).
POSTGRES_USER=abonent
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=abonent
POSTGRES_PORT=5432
API_PORT=8080

# Local Go commands use this URL. Compose builds its internal db URL separately.
# Update this value whenever POSTGRES_PASSWORD or POSTGRES_PORT changes.
DATABASE_URL=postgres://abonent:replace-with-a-local-password@localhost:5432/abonent?sslmode=disable
HTTP_ADDR=:8080
PUBLIC_WEB_URL=http://localhost:8090
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:8090

# Local Docker defaults. For production: bare domain, 80, 443 and HTTPS URL above.
SITE_ADDRESS=http://:80
WEB_HTTP_PORT=8090
WEB_HTTPS_PORT=8443

# Public client configuration for local Expo; Docker export always uses /api/v1.
# For a real phone use http://<computer-LAN-IP>:8090/api/v1 or a public HTTPS API.
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1
