{
  "expo": {
    "name": "Абонент",
    "slug": "abonent",
    "scheme": "abonent",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-system-ui"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Абонент"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "local.abonent.app"
    }
  }
}
